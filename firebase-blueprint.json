{
  "entities": {
    "AdminRoleDoc": {
      "title": "AdminRoleDoc",
      "description": "Trusted role registry document granting market administrator privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who granted access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was recorded."
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII supply chain profile preferences for an authenticated MandiLens user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the profile owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the grower, FPO manager, or buyer."
        },
        "supplyChainRole": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "FPO / Farmer Collective",
            "Independent Grower",
            "Commodity Buyer / Processor",
            "Cold Chain & Transport Fleet"
          ],
          "description": "Primary role in the agricultural supply chain."
        },
        "regionCluster": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Default APMC mandi cluster for the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "supplyChainRole",
        "regionCluster",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record storing the authenticated user's verified email address.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified account email address."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when private info was synced."
        }
      },
      "required": ["ownerId", "email", "updatedAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A bookmarked mandi lot in the user's persistent watchlist subcollection.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the watchlist owner."
        },
        "lotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the saved mandi lot."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmarked."
        }
      },
      "required": ["ownerId", "lotId", "createdAt"]
    },
    "SavedComparisonDoc": {
      "title": "SavedComparisonDoc",
      "description": "Persisted multi-mandi freight and net payout comparison scenario.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owner."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Scenario label."
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Commodity evaluated."
        },
        "compareCount": {
          "type": "number",
          "description": "Number of markets compared (2 or 3)."
        },
        "lotQtl": {
          "type": "number",
          "description": "Harvest lot volume in quintals."
        },
        "packagingPerQtl": {
          "type": "number",
          "description": "Packaging and grading cost per quintal."
        },
        "freightPerKmQtl": {
          "type": "number",
          "description": "Road freight rate in INR per km per quintal."
        },
        "shrinkagePer100Km": {
          "type": "number",
          "description": "Moisture and handling shrinkage percentage per 100 km."
        },
        "marketAName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "marketAPriceQtl": {
          "type": "number"
        },
        "marketADistanceKm": {
          "type": "number"
        },
        "marketBName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "marketBPriceQtl": {
          "type": "number"
        },
        "marketBDistanceKm": {
          "type": "number"
        },
        "marketCName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "marketCPriceQtl": {
          "type": "number"
        },
        "marketCDistanceKm": {
          "type": "number"
        },
        "bestMarketName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "bestNetPerQtl": {
          "type": "number"
        },
        "bestNetTotalInr": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["active", "locked"],
          "description": "Scenario lock status; locked is terminal."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "commodity",
        "compareCount",
        "lotQtl",
        "packagingPerQtl",
        "freightPerKmQtl",
        "shrinkagePer100Km",
        "marketAName",
        "marketAPriceQtl",
        "marketADistanceKm",
        "marketBName",
        "marketBPriceQtl",
        "marketBDistanceKm",
        "marketCName",
        "marketCPriceQtl",
        "marketCDistanceKm",
        "bestMarketName",
        "bestNetPerQtl",
        "bestNetTotalInr",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlertSubscriptionDoc": {
      "title": "AlertSubscriptionDoc",
      "description": "Daily morning mandi clearing price digest subscription owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the subscriber."
        },
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Name of FPO, farm, or buying enterprise."
        },
        "supplyChainRole": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "FPO / Farmer Collective",
            "Independent Grower",
            "Commodity Buyer / Processor",
            "Cold Chain & Transport Fleet"
          ],
          "description": "Subscriber role."
        },
        "commodityGroup": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Target commodity category."
        },
        "regionCluster": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Target state and mandi corridor."
        },
        "contact": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "Validated mobile number or email for alert delivery."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of subscription creation."
        }
      },
      "required": [
        "ownerId",
        "organization",
        "supplyChainRole",
        "commodityGroup",
        "regionCluster",
        "contact",
        "createdAt"
      ]
    },
    "MandiLotDoc": {
      "title": "MandiLotDoc",
      "description": "Published APMC wholesale auction rate and arrival record stored in Firestore.",
      "type": "object",
      "properties": {
        "lotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "variety": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "maxLength": 40,
          "enum": ["Cereals & Pulses", "Vegetables", "Oilseeds & Spices"]
        },
        "mandi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "grade": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "moistureSpec": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "minPrice": {
          "type": "number"
        },
        "maxPrice": {
          "type": "number"
        },
        "modalPrice": {
          "type": "number"
        },
        "change24hPct": {
          "type": "number"
        },
        "arrivalsQtl": {
          "type": "number"
        },
        "defaultDistanceKm": {
          "type": "number"
        },
        "mandiFeePct": {
          "type": "number"
        },
        "hamaliPerQtl": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "maxLength": 20,
          "enum": ["published", "archived"]
        },
        "verificationTier": {
          "type": "string",
          "maxLength": 24,
          "enum": ["official_apmc", "fpo_verified"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "lotId",
        "authorId",
        "commodity",
        "variety",
        "category",
        "mandi",
        "district",
        "state",
        "grade",
        "moistureSpec",
        "minPrice",
        "maxPrice",
        "modalPrice",
        "change24hPct",
        "arrivalsQtl",
        "defaultDistanceKm",
        "mandiFeePct",
        "hamaliPerQtl",
        "status",
        "verificationTier",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProcurementLedgerDoc": {
      "title": "ProcurementLedgerDoc",
      "description": "Supply chain truck dispatch and procurement settlement ledger record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "originCluster": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "destinationMandi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "quantityQtl": {
          "type": "number"
        },
        "expectedNetPerQtl": {
          "type": "number"
        },
        "dispatchStatus": {
          "type": "string",
          "maxLength": 20,
          "enum": ["planned", "in_transit", "settled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "organization",
        "commodity",
        "originCluster",
        "destinationMandi",
        "quantityQtl",
        "expectedNetPerQtl",
        "dispatchStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "FieldQuoteDoc": {
      "title": "FieldQuoteDoc",
      "description": "User-logged field mandi auction quote persisted in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "variety": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "maxLength": 40,
          "enum": ["Cereals & Pulses", "Vegetables", "Oilseeds & Spices"]
        },
        "mandi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "grade": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "modalPrice": {
          "type": "number"
        },
        "minPrice": {
          "type": "number"
        },
        "maxPrice": {
          "type": "number"
        },
        "arrivalsQtl": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "commodity",
        "variety",
        "category",
        "mandi",
        "district",
        "state",
        "grade",
        "modalPrice",
        "minPrice",
        "maxPrice",
        "arrivalsQtl",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRoleDoc" },
      "description": "Trusted registry of MandiLens market administrators."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user supply chain profile (non-PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Split-collection PII storage for verified user email."
    },
    "/users/{userId}/watchlist/{lotId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "Per-user subcollection of saved mandi lots."
    },
    "/users/{userId}/savedComparisons/{comparisonId}": {
      "schema": { "$ref": "#/entities/SavedComparisonDoc" },
      "description": "Per-user subcollection of saved multi-mandi arbitrage comparisons."
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/AlertSubscriptionDoc" },
      "description": "Per-user subcollection of daily corridor alert subscriptions."
    },
    "/mandiLots/{lotId}": {
      "schema": { "$ref": "#/entities/MandiLotDoc" },
      "description": "Shared database of verified APMC and FPO mandi auction lots."
    },
    "/procurementOrders/{orderId}": {
      "schema": { "$ref": "#/entities/ProcurementLedgerDoc" },
      "description": "Owner-scoped supply chain truck dispatch and settlement ledger."
    },
    "/fieldQuotes/{quoteId}": {
      "schema": { "$ref": "#/entities/FieldQuoteDoc" },
      "description": "Owner-scoped logged mandi field auction observations."
    }
  }
}
