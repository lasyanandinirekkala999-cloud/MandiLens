rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped Admin (verified email required to prevent email spoofing) + Trusted Registry
    function isAdmin() {
      return isVerifiedUser() && (
        ('email' in request.auth.token &&
          request.auth.token.email == 'nagireddyrekkala999@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSupplyChainRole(role) {
      return role is string &&
        role.size() >= 1 &&
        role.size() <= 50 &&
        (
          role == 'FPO / Farmer Collective' ||
          role == 'Independent Grower' ||
          role == 'Commodity Buyer / Processor' ||
          role == 'Cold Chain & Transport Fleet'
        );
    }

    function isValidCropCategory(cat) {
      return cat is string &&
        cat.size() >= 2 &&
        cat.size() <= 40 &&
        (
          cat == 'Cereals & Pulses' ||
          cat == 'Vegetables' ||
          cat == 'Oilseeds & Spices'
        );
    }

    function hasActiveParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // =========================================================================
    // Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    // =========================================================================
    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.grantedBy == request.auth.uid &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'supplyChainRole',
          'regionCluster',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'supplyChainRole',
          'regionCluster',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        isValidSupplyChainRole(data.supplyChainRole) &&
        data.regionCluster is string &&
        data.regionCluster.size() >= 2 &&
        data.regionCluster.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['ownerId', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 160 &&
        data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['ownerId', 'lotId', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'lotId', 'createdAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidId(data.lotId) &&
        data.createdAt is timestamp;
    }

    function isValidSavedComparison(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'commodity',
          'compareCount',
          'lotQtl',
          'packagingPerQtl',
          'freightPerKmQtl',
          'shrinkagePer100Km',
          'marketAName',
          'marketAPriceQtl',
          'marketADistanceKm',
          'marketBName',
          'marketBPriceQtl',
          'marketBDistanceKm',
          'marketCName',
          'marketCPriceQtl',
          'marketCDistanceKm',
          'bestMarketName',
          'bestNetPerQtl',
          'bestNetTotalInr',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'title',
          'commodity',
          'compareCount',
          'lotQtl',
          'packagingPerQtl',
          'freightPerKmQtl',
          'shrinkagePer100Km',
          'marketAName',
          'marketAPriceQtl',
          'marketADistanceKm',
          'marketBName',
          'marketBPriceQtl',
          'marketBDistanceKm',
          'marketCName',
          'marketCPriceQtl',
          'marketCDistanceKm',
          'bestMarketName',
          'bestNetPerQtl',
          'bestNetTotalInr',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.title is string &&
        data.title.size() >= 2 &&
        data.title.size() <= 100 &&
        data.commodity is string &&
        data.commodity.size() >= 2 &&
        data.commodity.size() <= 80 &&
        data.compareCount is number &&
        (data.compareCount == 2 || data.compareCount == 3) &&
        data.lotQtl is number &&
        data.lotQtl >= 1 &&
        data.lotQtl <= 10000 &&
        data.packagingPerQtl is number &&
        data.packagingPerQtl >= 0 &&
        data.packagingPerQtl <= 2000 &&
        data.freightPerKmQtl is number &&
        data.freightPerKmQtl >= 0 &&
        data.freightPerKmQtl <= 50 &&
        data.shrinkagePer100Km is number &&
        data.shrinkagePer100Km >= 0 &&
        data.shrinkagePer100Km <= 25 &&
        data.marketAName is string &&
        data.marketAName.size() >= 2 &&
        data.marketAName.size() <= 80 &&
        data.marketAPriceQtl is number &&
        data.marketAPriceQtl >= 0 &&
        data.marketAPriceQtl <= 100000 &&
        data.marketADistanceKm is number &&
        data.marketADistanceKm >= 0 &&
        data.marketADistanceKm <= 5000 &&
        data.marketBName is string &&
        data.marketBName.size() >= 2 &&
        data.marketBName.size() <= 80 &&
        data.marketBPriceQtl is number &&
        data.marketBPriceQtl >= 0 &&
        data.marketBPriceQtl <= 100000 &&
        data.marketBDistanceKm is number &&
        data.marketBDistanceKm >= 0 &&
        data.marketBDistanceKm <= 5000 &&
        data.marketCName is string &&
        data.marketCName.size() >= 1 &&
        data.marketCName.size() <= 80 &&
        data.marketCPriceQtl is number &&
        data.marketCPriceQtl >= 0 &&
        data.marketCPriceQtl <= 100000 &&
        data.marketCDistanceKm is number &&
        data.marketCDistanceKm >= 0 &&
        data.marketCDistanceKm <= 5000 &&
        data.bestMarketName is string &&
        data.bestMarketName.size() >= 2 &&
        data.bestMarketName.size() <= 80 &&
        data.bestNetPerQtl is number &&
        data.bestNetTotalInr is number &&
        data.status is string &&
        data.status.size() <= 20 &&
        (data.status == 'active' || data.status == 'locked') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAlertSubscription(data) {
      return data.keys().hasAll([
          'ownerId',
          'organization',
          'supplyChainRole',
          'commodityGroup',
          'regionCluster',
          'contact',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'organization',
          'supplyChainRole',
          'commodityGroup',
          'regionCluster',
          'contact',
          'createdAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.organization is string &&
        data.organization.size() >= 2 &&
        data.organization.size() <= 100 &&
        isValidSupplyChainRole(data.supplyChainRole) &&
        data.commodityGroup is string &&
        data.commodityGroup.size() >= 2 &&
        data.commodityGroup.size() <= 80 &&
        data.regionCluster is string &&
        data.regionCluster.size() >= 2 &&
        data.regionCluster.size() <= 80 &&
        data.contact is string &&
        data.contact.size() >= 5 &&
        data.contact.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidMandiLot(data) {
      return data.keys().hasAll([
          'lotId',
          'authorId',
          'commodity',
          'variety',
          'category',
          'mandi',
          'district',
          'state',
          'grade',
          'moistureSpec',
          'minPrice',
          'maxPrice',
          'modalPrice',
          'change24hPct',
          'arrivalsQtl',
          'defaultDistanceKm',
          'mandiFeePct',
          'hamaliPerQtl',
          'status',
          'verificationTier',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'lotId',
          'authorId',
          'commodity',
          'variety',
          'category',
          'mandi',
          'district',
          'state',
          'grade',
          'moistureSpec',
          'minPrice',
          'maxPrice',
          'modalPrice',
          'change24hPct',
          'arrivalsQtl',
          'defaultDistanceKm',
          'mandiFeePct',
          'hamaliPerQtl',
          'status',
          'verificationTier',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.lotId) &&
        isValidId(data.authorId) &&
        data.commodity is string &&
        data.commodity.size() >= 2 &&
        data.commodity.size() <= 60 &&
        data.variety is string &&
        data.variety.size() >= 2 &&
        data.variety.size() <= 80 &&
        isValidCropCategory(data.category) &&
        data.mandi is string &&
        data.mandi.size() >= 2 &&
        data.mandi.size() <= 80 &&
        data.district is string &&
        data.district.size() >= 2 &&
        data.district.size() <= 60 &&
        data.state is string &&
        data.state.size() >= 2 &&
        data.state.size() <= 50 &&
        data.grade is string &&
        data.grade.size() >= 2 &&
        data.grade.size() <= 50 &&
        data.moistureSpec is string &&
        data.moistureSpec.size() >= 2 &&
        data.moistureSpec.size() <= 50 &&
        data.modalPrice is number &&
        data.modalPrice >= 100 &&
        data.modalPrice <= 100000 &&
        data.minPrice is number &&
        data.minPrice >= 50 &&
        data.minPrice <= data.modalPrice &&
        data.maxPrice is number &&
        data.maxPrice >= data.modalPrice &&
        data.maxPrice <= 120000 &&
        data.change24hPct is number &&
        data.change24hPct >= -100 &&
        data.change24hPct <= 100 &&
        data.arrivalsQtl is number &&
        data.arrivalsQtl >= 1 &&
        data.arrivalsQtl <= 1000000 &&
        data.defaultDistanceKm is number &&
        data.defaultDistanceKm >= 0 &&
        data.defaultDistanceKm <= 5000 &&
        data.mandiFeePct is number &&
        data.mandiFeePct >= 0 &&
        data.mandiFeePct <= 15 &&
        data.hamaliPerQtl is number &&
        data.hamaliPerQtl >= 0 &&
        data.hamaliPerQtl <= 500 &&
        data.status is string &&
        data.status.size() <= 20 &&
        (data.status == 'published' || data.status == 'archived') &&
        data.verificationTier is string &&
        data.verificationTier.size() <= 24 &&
        (data.verificationTier == 'official_apmc' || data.verificationTier == 'fpo_verified') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProcurementOrder(data) {
      return data.keys().hasAll([
          'ownerId',
          'organization',
          'commodity',
          'originCluster',
          'destinationMandi',
          'quantityQtl',
          'expectedNetPerQtl',
          'dispatchStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'organization',
          'commodity',
          'originCluster',
          'destinationMandi',
          'quantityQtl',
          'expectedNetPerQtl',
          'dispatchStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.organization is string &&
        data.organization.size() >= 2 &&
        data.organization.size() <= 100 &&
        data.commodity is string &&
        data.commodity.size() >= 2 &&
        data.commodity.size() <= 60 &&
        data.originCluster is string &&
        data.originCluster.size() >= 2 &&
        data.originCluster.size() <= 80 &&
        data.destinationMandi is string &&
        data.destinationMandi.size() >= 2 &&
        data.destinationMandi.size() <= 80 &&
        data.quantityQtl is number &&
        data.quantityQtl >= 1 &&
        data.quantityQtl <= 50000 &&
        data.expectedNetPerQtl is number &&
        data.expectedNetPerQtl >= 50 &&
        data.expectedNetPerQtl <= 100000 &&
        data.dispatchStatus is string &&
        data.dispatchStatus.size() <= 20 &&
        (
          data.dispatchStatus == 'planned' ||
          data.dispatchStatus == 'in_transit' ||
          data.dispatchStatus == 'settled'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFieldQuote(data) {
      return data.keys().hasAll([
          'ownerId',
          'commodity',
          'variety',
          'category',
          'mandi',
          'district',
          'state',
          'grade',
          'modalPrice',
          'minPrice',
          'maxPrice',
          'arrivalsQtl',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'commodity',
          'variety',
          'category',
          'mandi',
          'district',
          'state',
          'grade',
          'modalPrice',
          'minPrice',
          'maxPrice',
          'arrivalsQtl',
          'createdAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.commodity is string &&
        data.commodity.size() >= 2 &&
        data.commodity.size() <= 60 &&
        data.variety is string &&
        data.variety.size() >= 2 &&
        data.variety.size() <= 80 &&
        isValidCropCategory(data.category) &&
        data.mandi is string &&
        data.mandi.size() >= 2 &&
        data.mandi.size() <= 80 &&
        data.district is string &&
        data.district.size() >= 2 &&
        data.district.size() <= 60 &&
        data.state is string &&
        data.state.size() >= 2 &&
        data.state.size() <= 50 &&
        data.grade is string &&
        data.grade.size() >= 2 &&
        data.grade.size() <= 50 &&
        data.modalPrice is number &&
        data.modalPrice >= 200 &&
        data.modalPrice <= 50000 &&
        data.minPrice is number &&
        data.minPrice >= 100 &&
        data.minPrice <= data.modalPrice &&
        data.maxPrice is number &&
        data.maxPrice >= data.modalPrice &&
        data.maxPrice <= 60000 &&
        data.arrivalsQtl is number &&
        data.arrivalsQtl >= 10 &&
        data.arrivalsQtl <= 1000000 &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // 0. /admins/{adminUid} (Trusted Market Admin Registry)
    // =========================================================================
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() &&
        isValidId(adminUid) &&
        (request.auth.uid == adminUid || isAdmin());

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(adminUid) &&
        isValidAdminDoc(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time &&
        isAdmin();

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminUid) && isAdmin();
    }

    // =========================================================================
    // 1. /users/{userId} (Non-PII Profile)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (isOwner(userId) || isAdmin());

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            // Action: Owner Updates Supply Chain Preferences
            isOwner(userId) &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'supplyChainRole',
              'regionCluster',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if false;

      // =======================================================================
      // 2. /users/{userId}/private/{docId} (Split-Collection PII Isolation)
      // =======================================================================
      match /private/{docId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          ((isOwner(userId) && hasActiveParentUser(userId)) || isAdmin());

        allow list: if false;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          'email' in request.auth.token &&
          incoming().email == request.auth.token.email &&
          incoming().updatedAt == request.time &&
          (
            hasActiveParentUser(userId) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedUser() &&
          isValidUserPrivateInfo(incoming()) &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          incoming().ownerId == existing().ownerId &&
          incoming().updatedAt == request.time &&
          (
            (
              // Action: Sync Verified Email Timestamp
              isOwner(userId) &&
              existing().ownerId == request.auth.uid &&
              incoming().email == request.auth.token.email &&
              incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
              hasActiveParentUser(userId)
            ) ||
            isAdmin()
          );

        allow delete: if false;
      }

      // =======================================================================
      // 3. /users/{userId}/watchlist/{lotId}
      // =======================================================================
      match /watchlist/{lotId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(lotId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(lotId) &&
          isValidWatchlistItem(incoming()) &&
          incoming().lotId == lotId &&
          incoming().createdAt == request.time &&
          hasActiveParentUser(userId);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(lotId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);
      }

      // =======================================================================
      // 4. /users/{userId}/savedComparisons/{comparisonId}
      // =======================================================================
      match /savedComparisons/{comparisonId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(comparisonId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(comparisonId) &&
          isValidSavedComparison(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveParentUser(userId);

        allow update: if isVerifiedUser() &&
          isValidSavedComparison(incoming()) &&
          isValidId(userId) &&
          isValidId(comparisonId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              // Action: Lock Comparison Decision (Terminal State Lock)
              isOwner(userId) &&
              existing().ownerId == request.auth.uid &&
              existing().status == 'active' &&
              incoming().status == 'locked' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
              hasActiveParentUser(userId)
            ) ||
            isAdmin()
          );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(comparisonId) &&
          (
            (
              isOwner(userId) &&
              existing().ownerId == request.auth.uid &&
              existing().status != 'locked' &&
              hasActiveParentUser(userId)
            ) ||
            isAdmin()
          );
      }

      // =======================================================================
      // 5. /users/{userId}/subscriptions/{subscriptionId}
      // =======================================================================
      match /subscriptions/{subscriptionId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(subscriptionId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(subscriptionId) &&
          isValidAlertSubscription(incoming()) &&
          incoming().createdAt == request.time &&
          hasActiveParentUser(userId);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(subscriptionId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);
      }
    }

    // =========================================================================
    // 6. /mandiLots/{lotId} (Shared APMC & Verified Market Database)
    // =========================================================================
    match /mandiLots/{lotId} {
      allow get: if isValidId(lotId) &&
        (
          existing().status == 'published' ||
          (isSignedIn() && existing().authorId == request.auth.uid) ||
          isAdmin()
        );

      // Pillar 8: Explicit resource.data evaluation with ZERO get()/exists() calls
      allow list: if existing().status == 'published';

      allow create: if isVerifiedUser() &&
        isValidId(lotId) &&
        isValidMandiLot(incoming()) &&
        incoming().lotId == lotId &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'published' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().verificationTier == 'fpo_verified' &&
            exists(/databases/$(database)/documents/users/$(incoming().authorId))
          ) ||
          (
            incoming().verificationTier == 'official_apmc' &&
            isAdmin()
          )
        );

      allow update: if isVerifiedUser() &&
        isValidMandiLot(incoming()) &&
        isValidId(lotId) &&
        incoming().lotId == existing().lotId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            // Action: FPO Author Refreshes Active Quote Rates
            existing().status != 'archived' &&
            existing().authorId == request.auth.uid &&
            existing().verificationTier == 'fpo_verified' &&
            incoming().verificationTier == 'fpo_verified' &&
            incoming().status == 'published' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'minPrice',
              'maxPrice',
              'modalPrice',
              'change24hPct',
              'arrivalsQtl',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() &&
        isValidId(lotId) &&
        (
          (
            existing().authorId == request.auth.uid &&
            existing().verificationTier == 'fpo_verified' &&
            existing().status != 'archived'
          ) ||
          isAdmin()
        );
    }

    // =========================================================================
    // 7. /procurementOrders/{orderId} (Supply Chain Dispatch Ledger Database)
    // =========================================================================
    match /procurementOrders/{orderId} {
      allow get: if isSignedIn() &&
        isValidId(orderId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      // Pillar 8: Explicit resource.data owner enforcement, zero get()/exists()
      allow list: if isSignedIn() &&
        existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidProcurementOrder(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().dispatchStatus == 'planned' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().ownerId));

      allow update: if isVerifiedUser() &&
        isValidProcurementOrder(incoming()) &&
        isValidId(orderId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            // Action 1: Mark Planned Lot as In Transit
            existing().ownerId == request.auth.uid &&
            existing().dispatchStatus == 'planned' &&
            incoming().dispatchStatus == 'in_transit' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['dispatchStatus', 'updatedAt'])
          ) ||
          (
            // Action 2: Settle Delivered Lot (Terminal State Lock)
            existing().ownerId == request.auth.uid &&
            existing().dispatchStatus == 'in_transit' &&
            incoming().dispatchStatus == 'settled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['dispatchStatus', 'updatedAt'])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() &&
        isValidId(orderId) &&
        (
          (
            existing().ownerId == request.auth.uid &&
            existing().dispatchStatus == 'planned'
          ) ||
          isAdmin()
        );
    }

    // =========================================================================
    // 8. /fieldQuotes/{quoteId} (Legacy Owner-Scoped Field Quotes)
    // =========================================================================
    match /fieldQuotes/{quoteId} {
      allow get: if isSignedIn() &&
        isValidId(quoteId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isSignedIn() &&
        existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(quoteId) &&
        isValidFieldQuote(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().ownerId));

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(quoteId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
